{
  "name": "logseq-property-rotator",
  "version": "0.1.22",
  "description": "Rotate Logseq block properties through configurable term lists with GTD/PARA profiles, prefix support, and cursor-aware rotation.",
  "type": "module",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "clean": "rm -rf dist",
    "build:clean": "rm -rf dist && vite build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "release:patch": "npm version patch -m 'release: v%s' && git push && git push --tags",
    "release:minor": "npm version minor -m 'release: v%s' && git push && git push --tags",
    "release:major": "npm version major -m 'release: v%s' && git push && git push --tags"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs"
          }
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/tests/**"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  },
  "author": "manu4linux",
  "license": "MIT",
  "dependencies": {
    "@logseq/libs": "^0.2.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.0",
    "ts-jest": "^29.1.0"
  },
  "logseq": {
    "id": "ManoPaduri-logseq-kpm-property-rotator",
    "title": "Property Rotator",
    "icon": "./icon.svg"
  }
}
